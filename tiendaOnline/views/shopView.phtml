        <div class="product-grid">
            <?php foreach ($productos as $producto): ?>
                <div class="product-card">
                    <img src="img/productos/<?php echo htmlspecialchars($producto->getImagen()); ?>" alt="<?php echo htmlspecialchars($producto->getName()); ?>" />
