<body>
    <div class="main-container">
        <h1> Tienda </h1>
        
        <div class="nav-links">
            <a href="index.php?c=shop&action=newProduct">Agregar nuevo producto</a>
            <a href="index.php?c=shop&action=viewCart">Ver carrito</a>
