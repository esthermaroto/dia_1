                    <p><?php echo htmlspecialchars($producto->getDescription()); ?></p>
                    <p class="price"><?php echo htmlspecialchars(number_format($producto->getPrice(), 2)); ?> €</p>
                    <a href="index.php?c=cart&action=add&id=<?php echo $producto->getIdProducto(); ?>" class="btn">Añadir al carrito</a>
                </div>
            <?php endforeach; ?>
        </div>
    </div>
