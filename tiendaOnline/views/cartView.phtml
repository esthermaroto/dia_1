<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carrito de Compras</title>
    <link rel="stylesheet" href="styles/style.css">
    <link rel="stylesheet" href="styles/cart.css">
</head>
<body>
    <div class="main-container">
        <h1>Carrito de Compras</h1>
        
        <?php if(isset($_SESSION['user']) && $_SESSION['user']): ?>
            <p style="text-align: center; color: #666; font-style: italic;">
                Carrito personal de: <strong><?php echo htmlspecialchars($_SESSION['user']->getUsername()); ?></strong>
            </p>
        <?php endif; ?>

        <div class="nav-links">
            <a href="index.php?c=shop" class="btn-secondary">Volver a la tienda</a>
        </div>

        <?php if(isset($_GET['error'])): ?>
            <div class="error-message">
                <?php 
                switch($_GET['error']) {
                    case 'checkout_failed':
                        echo "❌ Error al procesar el pedido. Por favor, inténtalo de nuevo.";
                        break;
                    case 'insufficient_stock':
                        echo "❌ Stock insuficiente para completar la compra.";
                        if(isset($_GET['details'])) {
                            echo "<br><small>" . htmlspecialchars(urldecode($_GET['details'])) . "</small>";
                        }
                        break;
                    default:
                        echo "❌ Ha ocurrido un error inesperado.";
                }
                ?>
            </div>
        <?php endif; ?>

        <?php if(empty($cartItems)): ?>
            <p style="text-align:center;">El carrito está vacío.</p>
        <?php else: ?>
            <table class="cart-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach($cartItems as $item): ?>
                        <tr>
                            <td><?php echo htmlspecialchars($item['name']); ?></td>
                            <td><?php echo htmlspecialchars($item['quantity']); ?></td>
                            <td><?php echo htmlspecialchars(number_format($item['price'], 2)); ?> €</td>
                            <td><?php echo htmlspecialchars(number_format($item['total'], 2)); ?> €</td>
                        </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>

            <div class="cart-total">
                <p>Total del carrito: <strong><?php echo htmlspecialchars(number_format($cartTotal, 2)); ?> €</strong></p>
                <div style="margin-top: 1rem;">
                    <a href="index.php?c=cart&action=checkout" class="btn">Proceder al pago</a>
                    <a href="index.php?c=cart&action=clear" class="btn-secondary" style="margin-left: 10px;" onclick="return confirm('¿Estás seguro de que quieres vaciar el carrito?')">Vaciar carrito</a>
                </div>
            </div>
        <?php endif; ?>
    </div>
</body>
</html>
